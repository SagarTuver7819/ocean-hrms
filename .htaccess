# Works whether the domain's document root is this folder or the public/ folder.
Options -Indexes
RewriteEngine On

RewriteRule ^(app|database|resources|storage|\.cursor)(/|$) - [F,L]
RewriteRule ^(README\.md|.*\.sql|.*\.ps1)$ - [F,L]

RewriteRule ^public(/.*)?$ - [L]
RewriteRule ^(.*)$ public/$1 [L]